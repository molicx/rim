FROM node:20-alpine

WORKDIR /app

# 设置 npm 使用国内镜像源（淘宝 npmmirror）
RUN npm config set registry https://registry.npmmirror.com

COPY package*.json ./

# 安装依赖，使用国内镜像加速
RUN npm install --registry=https://registry.npmmirror.com

COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
