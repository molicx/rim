FROM node:20-alpine

WORKDIR /app

# 设置 npm 使用国内镜像源（淘宝 npmmirror）
RUN npm config set registry https://registry.npmmirror.com

# 先复制 package 文件并安装依赖（利用缓存层）
COPY package*.json ./
RUN npm install --registry=https://registry.npmmirror.com

# 复制应用代码
COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
