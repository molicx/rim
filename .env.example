# 环境变量示例文件
# 复制此文件为 .env 并填入实际值

# ============================================
# Go 主服务配置
# ============================================

# 服务配置
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
GIN_MODE=debug

# 数据库配置
DB_HOST=postgres
DB_PORT=5432
DB_USER=rim_user
DB_PASSWORD=rim_password_dev
DB_NAME=rim_db
DB_SSL_MODE=disable

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRY=24h

# Python AI 服务地址
AI_SERVICE_URL=http://python-ai:8000

# 文件存储配置
STORAGE_TYPE=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=rim-files
MINIO_USE_SSL=false

# CORS 配置
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 日志配置
LOG_LEVEL=debug
LOG_FORMAT=json

# ============================================
# Python AI 服务配置
# ============================================

# 服务配置
API_PORT=8000
API_HOST=0.0.0.0

# Redis (Celery)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# AI 模型默认配置
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4

# OpenAI 配置
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_ORG_ID=

# Anthropic Claude 配置
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_API_BASE=https://api.anthropic.com

# Google Gemini 配置
GOOGLE_API_KEY=your-google-api-key-here

# Whisper 配置
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=auto

# 阿里云 OSS 配置（用于录音文件识别）
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=your_oss_bucket_name
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_REGION=cn-shanghai

# Celery 配置
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3000

# 日志配置
LOG_LEVEL=INFO

# ============================================
# 前端配置
# ============================================

# API 地址
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080

# 应用配置
VITE_APP_NAME=RIM
VITE_APP_VERSION=0.1.0

# ============================================
# 数据库配置（仅用于 docker-compose）
# ============================================

POSTGRES_USER=rim_user
POSTGRES_PASSWORD=rim_password_dev
POSTGRES_DB=rim_db

# ============================================
# MinIO 配置（仅用于 docker-compose）
# ============================================

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
